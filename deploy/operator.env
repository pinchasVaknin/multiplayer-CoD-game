# OPERATOR dedicated server configuration (M10, S4.9 and S6.6).
#
# Everything operational lives here. S4.9: "The server address is configuration, injected at
# build or runtime. Never hardcoded." Nothing in this file has a hardcoded counterpart in the
# source — see src/server/Config.ts, which reads exactly these names and clamps every one.

# ---- listener --------------------------------------------------------------
# Bind loopback when a reverse proxy on the same host terminates TLS in front (the
# recommended layout below). Use 0.0.0.0 only if the process is directly exposed.
HOST=127.0.0.1
PORT=8080

# ---- TLS -------------------------------------------------------------------
# Leave both blank to serve plain ws:// and let Caddy, nginx or a tunnel terminate TLS.
# Set both to have Node terminate it itself, in which case HOST must not be loopback.
TLS_CERT=
TLS_KEY=

# ---- the match -------------------------------------------------------------
# M10 is scoped to TDM on Foundry (S6). Both are configuration anyway, because the server has
# no reason to hardcode what M11 is about to widen.
MAP=mp_foundry
MODE=TDM
BOTS=8
SEED=1

# ---- netcode ---------------------------------------------------------------
# Snapshots per second, decoupled from the 60 Hz sim (S4.12 asks for 20-30). At 20 Hz an
# interval is 50 ms, so the 100 ms interpolation delay is exactly two intervals of buffer.
SNAPSHOT_HZ=20
INTERP_MS=100

# ---- observability ---------------------------------------------------------
# One structured metrics record every N seconds (S7). Zero disables it.
METRICS_SECONDS=30

# ---- diagnostics — leave these OFF in production ---------------------------
# Artificial conditions applied to every outbound link. Normally set per-client from the
# browser with ?net=, not here; this is for reproducing a report server-side.
#   NET_SIM=100        +100 ms round trip
#   NET_SIM=bad        100 ms +/-30 ms jitter, 2% loss
NET_SIM=

# Turn lag compensation off. Diagnostic only — it exists so the value of rewind can be
# measured against a run with it on (S8.6). The server logs a warning while it is set.
REWIND_DISABLED=
